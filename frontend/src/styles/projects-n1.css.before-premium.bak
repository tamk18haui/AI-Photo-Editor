.lum-project-filters{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.lum-project-filters .search-shell{display:flex;align-items:center;gap:8px}.lum-project-filters select,.lum-project-iconbutton{background:#fff;border:1px solid #e5dff4;border-radius:10px;padding:11px;color:#4a387c}.lum-project-iconbutton{cursor:pointer;display:grid;place-items:center}.lum-project-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:20px;margin-top:26px}.lum-project-card{overflow:hidden;background:#fff;border:1px solid #e8e1f7;border-radius:17px;box-shadow:0 8px 26px #563c9b13}.lum-project-thumb{height:165px;background:linear-gradient(135deg,#f8f4ff,#ddd2ff);color:#9b7fe3;display:grid;place-items:center;cursor:pointer}.lum-project-thumb img{width:100%;height:100%;object-fit:cover}.lum-project-details{padding:16px}.lum-project-details h3{font-size:16px;margin:0 0 8px;overflow-wrap:anywhere;color:#211a40}.lum-project-details p{margin:0 0 6px;color:#6b6184}.lum-project-details small{color:#8a80a2}.lum-project-actions{display:flex;gap:7px;margin-top:15px}.lum-project-actions button{cursor:pointer;border:1px solid #e8e0f8;background:#faf8ff;border-radius:9px;padding:9px;color:#6a4bd8;display:flex;align-items:center;gap:6px}.lum-project-actions button:first-child{flex:1;justify-content:center}.lum-project-actions button.danger{color:#bd354b}.lum-project-actions button:disabled{opacity:.5;cursor:wait}.lum-project-alert,.lum-project-ok{padding:12px;border-radius:10px;margin:14px 0;color:#a32132;background:#fff0f1}.lum-project-ok{color:#147044;background:#eaf8ee}.lum-project-loading{display:flex;gap:12px;padding:48px;align-items:center;justify-content:center;color:#6e55b6}.lum-project-spin{animation:lum-project-spin 1s linear infinite}@keyframes lum-project-spin{to{transform:rotate(360deg)}}.lum-project-pagination{display:flex;align-items:center;justify-content:center;gap:20px;margin:25px 0}.lum-project-pagination button{cursor:pointer;background:white;border:1px solid #ded5f4;padding:10px 14px;border-radius:10px}.lum-project-pagination button:disabled{opacity:.4;cursor:default}.lum-project-modal-backdrop{position:fixed;inset:0;z-index:1000;background:#1c163a99;display:grid;place-items:center;padding:15px}.lum-project-modal{max-width:480px;width:100%;background:white;border-radius:20px;padding:24px;box-shadow:0 20px 70px #08052050;color:#211936}.lum-project-modal-head{display:flex;justify-content:space-between;align-items:center}.lum-project-modal-head h2{font-size:22px;margin:0 0 18px}.lum-project-modal-head button{background:none;border:0;cursor:pointer}.lum-project-modal-form{display:grid;gap:14px}.lum-project-modal-form label{display:grid;gap:7px;font-weight:600}.lum-project-modal-form input{width:100%;min-width:0;padding:12px;border-radius:9px;border:1px solid #dcd5eb;font:inherit}.lum-project-size{display:grid;grid-template-columns:1fr 1fr;gap:12px}.lum-project-modal-buttons{display:flex;justify-content:flex-end;gap:10px;margin-top:18px}.lum-project-modal-buttons button{padding:11px 17px;border:1px solid #dcd5ec;border-radius:9px;cursor:pointer;background:#fff}.lum-project-modal-buttons .save{background:#7547ed;color:white;border-color:#7547ed}.lum-project-modal-buttons .destructive{background:#c52c4c;border-color:#c52c4c;color:white}@media(max-width:700px){.lum-project-filters{width:100%;margin-top:12px}.lum-project-size{grid-template-columns:1fr}}

/* N1 - Fixed project thumbnail layout */

.lum-project-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 20px;
  align-items: stretch;
}

.lum-project-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  overflow: hidden;
  background: #fff;
  border: 1px solid #e8e1f7;
  border-radius: 17px;
}

/* Khung ảnh bìa cố định tỷ lệ 16:9 */
.lum-project-thumb {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  min-height: 0;
  overflow: hidden;
  flex-shrink: 0;
  background: #f4f0fc;
  cursor: pointer;
}

/* Ảnh dọc, ngang, vuông đều nằm trong khung */
.lum-project-thumb img {
  display: block;
  width: 100%;
  height: 100%;
  max-width: 100%;
  max-height: 100%;
  min-width: 0;
  min-height: 0;
  object-fit: contain;
  object-position: center;
}

/* Thông tin luôn nằm bên dưới ảnh */
.lum-project-details {
  position: relative;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  padding: 16px;
  background: #fff;
}

.lum-project-details h3 {
  margin: 0 0 8px;
  font-size: 16px;
  color: #211a40;
  overflow-wrap: anywhere;
}

.lum-project-actions {
  display: flex;
  gap: 7px;
  margin-top: auto;
  padding-top: 15px;
}

.lum-project-actions button {
  min-width: 0;
}

.lum-project-actions button:first-child {
  flex: 1;
  justify-content: center;
}

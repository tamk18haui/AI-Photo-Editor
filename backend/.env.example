# Example only - safe to COMMIT to GitHub. Copy to .env on each computer.
# Spring Boot loads backend/.env via spring.config.import in application.yml.
# Every developer sets their OWN DB password / secrets locally.
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/ai_photo_editor?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC
DB_USERNAME=root
DB_PASSWORD=
JWT_SIGNING_SECRET=
JWT_ISSUER=ai-photo-editor
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=

# N4 Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# N4 private Python runner
AI_RUNNER_URL=http://127.0.0.1:8010
AI_RUNNER_TOKEN=
AI_JOB_POLL_DELAY_MS=1500

# N5 / future provider
GEMINI_API_KEY=

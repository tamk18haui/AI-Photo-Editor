# Load these as environment variables in IntelliJ Run Configuration; Spring Boot does not auto-load .env
DB_URL=jdbc:mysql://localhost:3306/ai_photo_editor?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC
DB_USERNAME=ai_editor
DB_PASSWORD=REPLACE_ME
JWT_SIGNING_SECRET=REPLACE_WITH_RANDOM_32_BYTE_MINIMUM_SECRET
JWT_ISSUER=ai-photo-editor
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=

# Copy this file to ai-runner/.env (never commit actual secrets).
# run.py reads it automatically, regardless of your current working directory.
# OS environment variables take precedence over this file.
AI_RUNNER_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_SECRET
AI_RUNNER_PORT=8010
# Leave blank to use ai-runner/weights. Relative paths resolve from ai-runner/.
AI_WEIGHTS_DIR=
AI_INPUT_MAX_BYTES=20971520
AI_OUTPUT_MAX_BYTES=83886080
AI_MAX_INPUT_PIXELS=40000000
AI_MAX_OUTPUT_PIXELS=80000000
AI_MAX_SELECTION_POINTS=64
